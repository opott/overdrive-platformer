    {"$GMRAssetLayer":"","%Name":"Assets_1","assets":[
        {"$GMRTextItem":"v3","%Name":"text_48A874CC1","alignment":257,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_48A874CC1","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.4,"scaleY":0.4,"text":"You are stuck in a loop","wrap":false,"x":32.0,"y":96.0,},
        {"$GMRTextItem":"v3","%Name":"text_797B7984_1","alignment":257,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":185.0,"frameW":864.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_797B7984_1","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.25,"scaleY":0.25,"text":"Press Enter to select a door\r\nOne will take you back to the start of this room\r\nOne will take you to the next room\r\nOne will take you to a random room\r\nSelect wisely","wrap":false,"x":64.0,"y":448.0,},
        {"$GMRTextItem":"v3","%Name":"text_6CAC5626","alignment":257,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_6CAC5626","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.4,"scaleY":0.4,"text":"Make your way to the bottom","wrap":false,"x":96.0,"y":128.0,},
        {"$GMRTextItem":"v3","%Name":"text_4CDE7753","alignment":257,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_4CDE7753","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.4,"scaleY":0.4,"text":"Watch out for spikes","wrap":false,"x":32.0,"y":224.0,},
        {"$GMRTextItem":"v3","%Name":"text_752834E6","alignment":257,"charSpacing":0.0,"colour":4294967295,"fontId":{"name":"Font1","path":"fonts/Font1/Font1.yy",},"frameH":0.0,"frameW":0.0,"frozen":false,"ignore":false,"inheritedItemId":null,"inheritItemSettings":false,"lineSpacing":0.0,"name":"text_752834E6","paragraphSpacing":0.0,"resourceType":"GMRTextItem","resourceVersion":"2.0","rotation":0.0,"scaleX":0.4,"scaleY":0.4,"text":"Hold shift to sprint","wrap":false,"x":160.0,"y":160.0,},
